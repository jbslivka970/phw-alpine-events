# Microsoft Entra External ID (preferred)
VITE_EXTERNAL_TENANT_NAME=your-external-tenant-name
VITE_EXTERNAL_TENANT_ID=your-external-tenant-id
VITE_EXTERNAL_CLIENT_ID=your-frontend-client-id
VITE_EXTERNAL_USER_FLOW=B2C_1_signupsignin

# Legacy B2C-compatible names (optional/backward-compatible)
VITE_AZURE_AD_B2C_TENANT_NAME=your-b2c-tenant-name
VITE_AZURE_TENANT_ID=your-b2c-tenant-id
VITE_AZURE_CLIENT_ID=your-b2c-client-id
VITE_AZURE_AD_B2C_POLICY_NAME=B2C_1_signupsignin

# Optional explicit authority settings (recommended for External ID)
# VITE_AZURE_AUTHORITY=https://your-tenant.ciamlogin.com/your-tenant.onmicrosoft.com/B2C_1_signupsignin
# VITE_AZURE_KNOWN_AUTHORITY=your-tenant.ciamlogin.com
# VITE_API_SCOPE=api://<backend-client-id>/access_as_user

# API
# Leave unset in local dev to use Vite proxy (/api -> http://localhost:3001).
# Set this in deployed environments where frontend and backend are on different origins.
# VITE_API_BASE_URL=https://phwalpineeventsjb873a.azurewebsites.net/api/v1