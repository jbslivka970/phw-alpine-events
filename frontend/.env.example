# Azure AD B2C (MSAL)
# Retrieve from Azure Portal > Azure AD B2C > App registrations (SPA registration)
VITE_AZURE_AD_B2C_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_AZURE_AD_B2C_TENANT=your-b2c-tenant.onmicrosoft.com
VITE_AZURE_AD_B2C_POLICY=B2C_1_signupsignin
VITE_AZURE_AD_B2C_REDIRECT_URI=http://localhost:5173

# Backend API base URL
VITE_API_BASE_URL=http://localhost:3001/api