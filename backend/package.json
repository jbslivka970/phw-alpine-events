{
  "name": "phw-alpine-events-backend",
  "version": "3.2.3",
  "description": "Backend API for PHW Alpine Events",
  "main": "server.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node server.js",
    "dev": "ts-node src/index.ts",
    "deploy-schema": "ts-node src/deploy-schema.ts",
    "test": "jest",
    "test:ci": "jest --runInBand --detectOpenHandles",
    "test:coverage": "jest --coverage",
    "test:coverage:ci": "jest --runInBand --coverage",
    "smoke:sms": "node ../scripts/sms-compliance-smoke.js",
    "smoke:email": "node ../scripts/email-unsubscribe-smoke.js",
    "smoke:rsvp": "node ../scripts/tokenized-rsvp-smoke.js",
    "smoke:redis": "node ../scripts/redis-health-smoke.js",
    "smoke:guest-assignments": "node ../scripts/guest-assignments-smoke.js",
    "smoke:ai": "node ../scripts/ai-description-smoke.js",
    "smoke:reminders": "node ../scripts/reminder-duplication-smoke.js",
    "smoke:all": "npm run smoke:sms && npm run smoke:email && npm run smoke:rsvp && npm run smoke:ai",
    "retention:run": "ts-node src/jobs/retentionJob.ts"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "dependencies": {
    "@azure/communication-email": "^1.0.0",
    "@azure/communication-sms": "^1.0.0",
    "@azure/functions": "^3.5.1",
    "@azure/identity": "^4.13.1",
    "@types/multer": "^2.1.0",
    "@types/pdfkit": "^0.17.5",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.0",
    "dotenv": "^17.4.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1",
    "mssql": "^12.2.1",
    "multer": "^2.1.1",
    "pdfkit": "^0.18.0",
    "redis": "^5.12.1",
    "twilio": "^5.10.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^9.1.9",
    "@types/node": "^25.5.2",
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.1",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "axios": "^1.15.0"
  }
}
