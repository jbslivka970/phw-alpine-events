# Azure SQL Database
# Retrieve from: az sql server show / az sql db show after ARM deployment
DB_HOST=phw-alpine-sql.database.windows.net
DB_PORT=1433
DB_NAME=phw-alpine-db
DB_USER=your-db-admin-user
DB_PASSWORD=your-db-admin-password

# Azure Communication Services (ACS)
# Retrieve from: az communication list-key --name phw-acs --resource-group phw-alpine-rg
ACS_CONNECTION_STRING=endpoint=https://phw-acs.communication.azure.com/;accesskey=YOUR_KEY
ACS_EMAIL_FROM=noreply@phw-alpine-events.azurecomm.net
ACS_SMS_FROM=+1xxxxxxxxxx

# Azure AD B2C
# Retrieve from Azure Portal > Azure AD B2C > App registrations
AZURE_AD_B2C_TENANT=your-b2c-tenant.onmicrosoft.com
AZURE_AD_B2C_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_AD_B2C_CLIENT_SECRET=your-b2c-client-secret
AZURE_AD_B2C_POLICY=B2C_1_signupsignin
AZURE_AD_B2C_ISSUER=https://your-b2c-tenant.b2clogin.com/your-b2c-tenant.onmicrosoft.com/v2.0/

# Application
NODE_ENV=development
PORT=3001

# API base URL (used by frontend proxy / CORS allow-list)
API_BASE_URL=http://localhost:3001