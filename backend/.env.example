# ============================================================
# PHW Alpine Events — Backend Environment Variables
#
# REQUIRED in production (NODE_ENV=production):
#   DB_HOST, DB_NAME, DB_USER, DB_PASSWORD
#
# REQUIRED for authentication to work:
#   AZURE_CLIENT_ID and either:
#     1) explicit issuer/jwks override (recommended for Entra External ID), or
#     2) tenant settings for B2C-compatible discovery
#
# OPTIONAL — service will start without these but features degrade:
#   ACS_CONNECTION_STRING (email disabled)
#   TELNYX_API_KEY + (TELNYX_MESSAGING_PROFILE_ID or TELNYX_FROM_NUMBER) (preferred SMS)
#   TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN/TWILIO_MESSAGING_SERVICE_SID (SMS fallback)
#   APPINSIGHTS_INSTRUMENTATIONKEY (telemetry disabled)
# ============================================================

# --- Azure SQL Database (REQUIRED in production) ---
DB_HOST=your-azure-sql-server.database.windows.net
DB_PORT=1433
DB_NAME=phw-alpine-events
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# --- Azure Communication Services (optional — stubs active without this) ---
ACS_CONNECTION_STRING=your-acs-connection-string
ACS_EMAIL_FROM=your-verified-email@domain.com
ACS_EMAIL_TO=regional-admin@projecthealingwaters.org
# Optional override for completed Event Record emails from the Events page.
# If unset, backend falls back to ACS_EMAIL_TO.
EVENT_RECORD_EMAIL_TO=regional-admin@projecthealingwaters.org

# Deprecated for outbound SMS (Twilio is now the only supported SMS provider)
ACS_SMS_FROM=+1234567890

# --- Telnyx Messaging (preferred for SMS delivery) ---
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_FROM_NUMBER=

# --- Twilio Messaging Service (optional fallback SMS provider) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# --- SMS consent rollout gates (optional, defaults to sarnitro@gmail.com only) ---
# Comma-separated lowercased emails that can enable SMS consent in-app.
# Example: SMS_CONSENT_ROLLOUT_EMAIL_ALLOWLIST=sarnitro@gmail.com,ops@example.com
SMS_CONSENT_ROLLOUT_EMAIL_ALLOWLIST=

# Comma-separated group names that can enable SMS consent in-app.
# Group match is case-insensitive against [group].group_name (e.g., Mentors,Veterans).
SMS_CONSENT_ROLLOUT_GROUP_ALLOWLIST=

# --- Microsoft Entra External ID / B2C-compatible auth ---
# Preferred explicit settings (External ID):
AZURE_AUTH_ISSUER=
AZURE_AUTH_JWKS_URI=

# Optional discovery settings (legacy B2C-compatible fallback):
AZURE_EXTERNAL_TENANT_NAME=your-external-tenant-name
AZURE_EXTERNAL_TENANT_ID=your-external-tenant-id
AZURE_AD_B2C_TENANT_NAME=your-b2c-tenant-name
AZURE_TENANT_ID=your-b2c-tenant-id
AZURE_CLIENT_ID=your-b2c-client-id
AZURE_AUTHORITY_HOST=b2clogin.com
AZURE_EXTERNAL_USER_FLOW=B2C_1_signupsignin
AZURE_AD_B2C_POLICY_NAME=B2C_1_signupsignin

# --- Member auth hardening (recommended) ---
# Enforce passwordless members. Local password sign-in is blocked unless email is allowlisted.
AUTH_ENFORCE_MEMBER_PASSWORDLESS=true
# Comma-separated lowercased emails allowed to use local password sign-in (admin + smoke only).
AUTH_LOCAL_PASSWORD_ALLOWLIST=admin@example.com,smoke-admin@example.com

# --- Authorization source-of-truth ---
# When false (recommended for production): roles come ONLY from the [user] table.
# When true: token-claim roles are merged on top (permissive; useful for dev/E2E).
# Default: false in NODE_ENV=production, true otherwise.
AUTH_ALLOW_TOKEN_ROLE_FALLBACK=

# --- Bootstrap administrators (recommended for production) ---
# Comma- or whitespace-separated email addresses that will be idempotently
# inserted into [user] with role='admin', is_active=1 on every server start.
# Existing rows are NEVER downgraded. Leave empty to disable tenant-admin
# bootstrap.
AUTH_BOOTSTRAP_ADMIN_EMAILS=

# Comma- or whitespace-separated email addresses that will be idempotently
# inserted/promoted into [user] as root admins (`role='superadmin'`,
# `is_root=1`, `root_role='root_admin'`) on every server start. Leave empty to
# disable root-admin bootstrap.
AUTH_BOOTSTRAP_ROOT_ADMIN_EMAILS=

# --- Application Insights (optional) ---
# Set either key OR full connection string — not both.
APPINSIGHTS_INSTRUMENTATIONKEY=
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
# Set false to disable telemetry startup even when a key is present.
APPINSIGHTS_ENABLED=true
# 0-100 percentage of telemetry sampled for ingestion cost control.
APPINSIGHTS_SAMPLING_PERCENTAGE=100
# Set false to avoid collecting console output into Application Insights.
APPINSIGHTS_COLLECT_CONSOLE=true

# --- CORS ---
CORS_ORIGIN=https://your-frontend-domain.com

# --- Public API base URL (recommended for one-click RSVP/email links) ---
PUBLIC_API_BASE_URL=https://your-backend-domain.com

# --- Server ---
NODE_ENV=development
PORT=3001

# --- GitHub scale workflow dispatch controls (optional) ---
# Set false to disable event-triggered scale-up workflow dispatch from POST /events.
GITHUB_SCALE_DISPATCH_ENABLED=true
# Minimum interval between dispatch attempts in milliseconds (default 15 minutes).
GITHUB_SCALE_DISPATCH_COOLDOWN_MS=900000

# --- Short-lived cache provider (optional, recommended for scale-out) ---
# CACHE_PROVIDER options:
#   auto   -> use Redis when REDIS_URL is present, otherwise in-memory
#   redis  -> force Redis mode
#   memory -> force in-memory mode
CACHE_PROVIDER=auto

# Redis connection URL (required when CACHE_PROVIDER=redis)
# Example: redis://localhost:6379
REDIS_URL=

# Prefix applied to all short-lived cache keys in Redis.
REDIS_KEY_PREFIX=phw:cache:

# When true, startup fails if Redis is unavailable or misconfigured.
CACHE_REDIS_REQUIRED=false

# Optional Redis connect timeout in milliseconds.
REDIS_CONNECT_TIMEOUT_MS=3000

# --- Local E2E auth bypass (development only) ---
# Enables deterministic Bearer tokens (e2e-admin, e2e-event_creator, e2e-user)
# for local Playwright/API role-matrix runs without Entra credentials.
E2E_LOCAL_AUTH_ENABLED=false

# --- Job scheduler tuning (optional) ---
# WAITLIST_JOB_INTERVAL_MS controls how often waitlist offers are expired/promoted.
WAITLIST_JOB_INTERVAL_MS=900000

# --- Retention cleanup controls (optional, recommended for production) ---
# Runs disabled by default; enable with RETENTION_JOB_ENABLED=true.
RETENTION_JOB_ENABLED=false
# Keep delete mode safe: default dry-run unless RETENTION_CONFIRM_DELETE=true.
RETENTION_DRY_RUN=true
RETENTION_CONFIRM_DELETE=false
# Maximum candidate rows allowed per target before aborting delete mode.
RETENTION_MAX_DELETE_PER_TARGET=50000
# Deletes are processed in batches to reduce lock and transaction pressure.
RETENTION_DELETE_BATCH_SIZE=5000
# Retention windows (days). Set <=0 to skip a target.
RETENTION_NOTIFICATION_LOG_DAYS=180
RETENTION_INBOUND_SMS_LOG_DAYS=365
RETENTION_EMAIL_PREFERENCE_LOG_DAYS=365

# --- AI invite drafting (optional) ---
# Preferred: Azure OpenAI deployment
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Optional compatibility path: public OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Entra identity provisioning from Admin -> Members (optional) ---
# App registration must have Graph application permission: User.Invite.All (admin consent granted).
ENTRA_PROVISIONING_TENANT_ID=
ENTRA_PROVISIONING_CLIENT_ID=
ENTRA_PROVISIONING_CLIENT_SECRET=
ENTRA_INVITE_REDIRECT_URL=https://app.phwcoloradoalpine.org
ENTRA_SEND_INVITATION_MESSAGE=true
