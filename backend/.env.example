# ============================================================
# PHW Alpine Events — Backend Environment Variables
#
# REQUIRED in production (NODE_ENV=production):
#   DB_HOST, DB_NAME, DB_USER, DB_PASSWORD
#
# REQUIRED for authentication to work:
#   AZURE_CLIENT_ID and either:
#     1) explicit issuer/jwks override (recommended for Entra External ID), or
#     2) tenant settings for B2C-compatible discovery
#
# OPTIONAL — service will start without these but features degrade:
#   ACS_CONNECTION_STRING (email/SMS disabled)
#   APPINSIGHTS_INSTRUMENTATIONKEY (telemetry disabled)
# ============================================================

# --- Azure SQL Database (REQUIRED in production) ---
DB_HOST=your-azure-sql-server.database.windows.net
DB_PORT=1433
DB_NAME=phw-alpine-events
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# --- Azure Communication Services (optional — stubs active without this) ---
ACS_CONNECTION_STRING=your-acs-connection-string
ACS_EMAIL_FROM=your-verified-email@domain.com
ACS_EMAIL_TO=regional-admin@projecthealingwaters.org
ACS_SMS_FROM=+1234567890

# --- Microsoft Entra External ID / B2C-compatible auth ---
# Preferred explicit settings (External ID):
AZURE_AUTH_ISSUER=
AZURE_AUTH_JWKS_URI=

# Optional discovery settings (legacy B2C-compatible fallback):
AZURE_EXTERNAL_TENANT_NAME=your-external-tenant-name
AZURE_EXTERNAL_TENANT_ID=your-external-tenant-id
AZURE_AD_B2C_TENANT_NAME=your-b2c-tenant-name
AZURE_TENANT_ID=your-b2c-tenant-id
AZURE_CLIENT_ID=your-b2c-client-id
AZURE_AUTHORITY_HOST=b2clogin.com
AZURE_EXTERNAL_USER_FLOW=B2C_1_signupsignin
AZURE_AD_B2C_POLICY_NAME=B2C_1_signupsignin

# --- Application Insights (optional) ---
# Set either key OR full connection string — not both.
APPINSIGHTS_INSTRUMENTATIONKEY=
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# --- CORS ---
CORS_ORIGIN=https://your-frontend-domain.com

# --- Server ---
NODE_ENV=development
PORT=3001

# --- Job scheduler tuning (optional) ---
# WAITLIST_JOB_INTERVAL_MS controls how often waitlist offers are expired/promoted.
WAITLIST_JOB_INTERVAL_MS=900000

# --- AI invite drafting (optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
